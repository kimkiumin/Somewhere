{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somewhere.example/qa/field/v2/release-run.schema.json",
  "title": "Somewhere V2 physical iPhone release run metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceOrigin",
    "runId",
    "buildSha",
    "navigationPolicyVersion",
    "navigationPolicySha256",
    "deployedUrl",
    "deviceModel",
    "iosVersion",
    "safariVersion",
    "browserMode",
    "environment",
    "displayMode",
    "wakeLockSupported",
    "wakeLockSustained",
    "startedAt",
    "endedAt",
    "durationSeconds",
    "routeId",
    "routeVersion",
    "routeDigest",
    "routeExpiresAt",
    "providerId",
    "providerVersion",
    "providerRightsDigest",
    "providerExpiresAt",
    "checklistSha256",
    "screensSha256",
    "traceSha256",
    "traceStoredPrivately",
    "rawTraceDisposition",
    "exactLocationPublished",
    "moderatorPresent",
    "gates",
    "unsafeEvents",
    "criticalDefects",
    "testerAttestation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceOrigin": { "enum": ["synthetic", "physical"] },
    "runId": { "enum": ["A", "B", "C", "D"] },
    "buildSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "navigationPolicyVersion": { "const": "navigation-v2-rc-1" },
    "navigationPolicySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "deployedUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "deviceModel": { "const": "iPhone 15 Pro Max" },
    "iosVersion": { "type": "string", "pattern": "^(1[89]|[2-9][0-9])\\.[0-9]+(\\.[0-9]+)?$" },
    "safariVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
    "browserMode": { "enum": ["safari", "home-screen"] },
    "environment": { "enum": ["open-sky", "building-dense"] },
    "displayMode": { "enum": ["browser", "standalone"] },
    "wakeLockSupported": { "type": "boolean" },
    "wakeLockSustained": { "type": "boolean" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "durationSeconds": { "type": "integer", "minimum": 1200 },
    "routeId": { "type": "string", "minLength": 3, "maxLength": 64 },
    "routeVersion": { "type": "string", "minLength": 3, "maxLength": 64 },
    "routeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "routeExpiresAt": { "type": "string", "format": "date-time" },
    "providerId": { "type": "string", "minLength": 3, "maxLength": 64 },
    "providerVersion": { "type": "string", "minLength": 3, "maxLength": 64 },
    "providerRightsDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "providerExpiresAt": { "type": "string", "format": "date-time" },
    "checklistSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "screensSha256": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z0-9._-]+\\.(png|txt)$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "traceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "traceStoredPrivately": { "const": true },
    "rawTraceDisposition": { "enum": ["retained-private", "discarded"] },
    "exactLocationPublished": { "const": false },
    "moderatorPresent": { "const": true },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P1", "P2", "P3", "P4", "P5", "P6", "P7"],
      "properties": {
        "P1": { "$ref": "#/$defs/gate" },
        "P2": { "$ref": "#/$defs/gate" },
        "P3": { "$ref": "#/$defs/gate" },
        "P4": { "$ref": "#/$defs/gate" },
        "P5": { "$ref": "#/$defs/gate" },
        "P6": { "$ref": "#/$defs/gate" },
        "P7": { "$ref": "#/$defs/gate" }
      }
    },
    "unsafeEvents": { "const": 0 },
    "criticalDefects": { "const": 0 },
    "testerAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tester", "moderator", "signedAt", "signatureSha256"],
      "properties": {
        "tester": { "type": "string", "minLength": 1, "maxLength": 100 },
        "moderator": { "type": "string", "minLength": 1, "maxLength": 100 },
        "signedAt": { "type": "string", "format": "date-time" },
        "signatureSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "keyId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "signatureBase64": { "type": "string", "contentEncoding": "base64" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evidenceOrigin": { "const": "physical" } },
        "required": ["evidenceOrigin"]
      },
      "then": {
        "properties": {
          "testerAttestation": {
            "required": [
              "tester",
              "moderator",
              "signedAt",
              "signatureSha256",
              "keyId",
              "signatureBase64"
            ]
          },
          "screensSha256": {
            "propertyNames": { "pattern": "^[A-Za-z0-9._-]+\\.png$" }
          }
        }
      }
    }
  ],
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observedAt", "notes"],
      "properties": {
        "status": { "const": "PASS" },
        "observedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
