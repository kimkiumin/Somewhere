{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somewhere.example/schemas/korea-review.v1.json",
  "title": "Somewhere Korean location/privacy release review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environment",
    "reviewedReleaseDigest",
    "reviewedDataFlowDigest",
    "reviewedRetentionPolicyDigest",
    "reviewedAt",
    "expiresAt",
    "reviewer",
    "classification",
    "crossBorder",
    "cloudflareFactsAcknowledged",
    "userRights",
    "openFindings",
    "conditions",
    "decision",
    "attestationDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environment": { "enum": ["staging", "production"] },
    "reviewedReleaseDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reviewedDataFlowDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reviewedRetentionPolicyDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "qualification", "organization", "independent"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "qualification": { "type": "string", "minLength": 1, "maxLength": 256 },
        "organization": { "type": "string", "minLength": 1, "maxLength": 128 },
        "independent": { "const": true }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locationInformationBusiness",
        "locationBasedServiceBusiness",
        "registrationOrReportingRequired",
        "evidenceDigest"
      ],
      "properties": {
        "locationInformationBusiness": {
          "enum": ["APPLIES", "DOES_NOT_APPLY", "COUNSEL_DETERMINATION_REQUIRED"]
        },
        "locationBasedServiceBusiness": {
          "enum": ["APPLIES", "DOES_NOT_APPLY", "COUNSEL_DETERMINATION_REQUIRED"]
        },
        "registrationOrReportingRequired": {
          "enum": ["REQUIRED_AND_COMPLETE", "NOT_REQUIRED", "UNRESOLVED"]
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "crossBorder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preciseLocationLeavesKorea",
        "destinationLeavesKorea",
        "countriesOrRegions",
        "legalBasis",
        "noticeAndConsentMechanism",
        "processorInventoryDigest"
      ],
      "properties": {
        "preciseLocationLeavesKorea": { "type": "boolean" },
        "destinationLeavesKorea": { "type": "boolean" },
        "countriesOrRegions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 64 }
        },
        "legalBasis": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "noticeAndConsentMechanism": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "processorInventoryDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "cloudflareFactsAcknowledged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "d1HasNoKoreaJurisdiction",
        "d1ApacIsOnlyHint",
        "doHasNoKoreaJurisdiction",
        "doApacNeIsOnlyHint",
        "regionalServicesDoesNotProveD1OrDoKoreaResidency",
        "d1TimeTravelDays",
        "doPitrDays"
      ],
      "properties": {
        "d1HasNoKoreaJurisdiction": { "const": true },
        "d1ApacIsOnlyHint": { "const": true },
        "doHasNoKoreaJurisdiction": { "const": true },
        "doApacNeIsOnlyHint": { "const": true },
        "regionalServicesDoesNotProveD1OrDoKoreaResidency": { "const": true },
        "d1TimeTravelDays": { "const": 7 },
        "doPitrDays": { "const": 30 }
      }
    },
    "userRights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privacyNoticeDigest",
        "deletionRunbookDigest",
        "incidentContact",
        "pitrDisclosureApproved"
      ],
      "properties": {
        "privacyNoticeDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "deletionRunbookDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "incidentContact": { "type": "string", "minLength": 1, "maxLength": 256 },
        "pitrDisclosureApproved": { "const": true }
      }
    },
    "openFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "severity": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "status": { "enum": ["OPEN", "ACCEPTED", "CLOSED"] }
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "decision": { "enum": ["PASS", "BLOCK"] },
    "attestationDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
