        "classification": "repository",
        "primary": "${FINAL_ROOT}/F2/review-work-verdict.json",
        "argv": ["bun", "scripts/release/run-bound-review.mjs", "--profile", "scripts/release/reviewer-profile-f2-code-v1.json", "--sha", "${FINAL_SHA}", "--source-tree", "${SOURCE_TREE}", "--inputs", "${FINAL_ROOT}/F2/verify-v2-verdict.json,${FINAL_ROOT}/F2/bun-audit.json,${FINAL_ROOT}/F2/red-team-verdict.json,${FINAL_ROOT}/F2/production-scan.json", "--output", "${FINAL_ROOT}/F2/review-work-verdict.json"]
