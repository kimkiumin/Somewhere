        "classification": "repository",
        "primary": "${FINAL_ROOT}/F4/blueprint-receipt.json",
        "argv": ["bun", "scripts/release/validate-blueprint-receipt.mjs", "--source-commit", "1cd08b3", "--receipt", "docs/blueprint/SOURCE_RECEIPT.md", "--root", ".", "--output", "${FINAL_ROOT}/F4/blueprint-receipt.json"]
