        "environment": { "SOMEWHERE_PREPARED_BASE_URL": "${BASE_URL}", "PLAYWRIGHT_JUNIT_OUTPUT_NAME": "${FINAL_ROOT}/F3/playwright-webkit.xml", "V2_EVIDENCE_DIR": "${TEMP_ROOT}/webkit-evidence" }
