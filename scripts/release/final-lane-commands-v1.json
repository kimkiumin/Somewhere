        "argv": ["bun", "app/qa/browser/v2/collect-manual-evidence.mjs", "--sha", "${FINAL_SHA}", "--source-tree", "${SOURCE_TREE}", "--base-url", "${BASE_URL}", "--build-receipt", "${BUILD_RECEIPT}", "--viewports", "320,390,430,wide", "--output-dir", "${FINAL_ROOT}/F3/manual-browser", "--output", "${FINAL_ROOT}/F3/manual-browser/collection.json"]
      },
      {
        "id": "manual-browser-validate",
        "classification": "repository",
        "primary": "${FINAL_ROOT}/F3/manual-browser-verdict.json",
        "argv": ["bun", "app/qa/browser/v2/validate-manual-evidence.mjs", "--sha", "${FINAL_SHA}", "--build-receipt", "${BUILD_RECEIPT}", "--input", "${FINAL_ROOT}/F3/manual-browser", "--output", "${FINAL_ROOT}/F3/manual-browser-verdict.json"]
