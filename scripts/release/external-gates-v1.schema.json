{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somewhere.invalid/schemas/external-gates-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "finalSha", "gates", "releaseGate"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "finalSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "gate", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "gate": { "enum": ["PASS", "BLOCK", "FAIL"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "releaseGate": { "enum": ["PASS", "BLOCK", "FAIL"] }
  }
}
