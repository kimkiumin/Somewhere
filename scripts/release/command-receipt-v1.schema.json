{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somewhere.invalid/schemas/command-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gate", "lane", "checkId", "finalSha", "sourceTree", "planSha256", "policy", "argv", "cwd", "environmentPolicy", "tool", "exitCode", "primary", "stdout", "stderr", "startedAt", "endedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gate": { "enum": ["PASS", "BLOCK", "FAIL"] },
    "lane": { "enum": ["F1", "F2", "F3", "F4", "FINAL"] },
    "checkId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "finalSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sourceTree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "planSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "policy": { "$ref": "#/$defs/policy" },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "cwd": { "type": "string", "minLength": 1 },
    "environmentPolicy": { "type": "string", "const": "credential-scrubbed-v1" },
    "tool": { "type": "object", "additionalProperties": false, "required": ["binary", "version"], "properties": { "binary": { "type": "string" }, "version": { "type": "string" } } },
    "exitCode": { "type": "integer" },
    "primary": { "$ref": "#/$defs/artifact" },
    "stdout": { "$ref": "#/$defs/artifact" },
    "stderr": { "$ref": "#/$defs/artifact" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
