{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somewhere.invalid/schemas/final-lane-commands-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lanes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["F1", "F2", "F3", "F4"],
      "properties": {
        "F1": { "$ref": "#/$defs/commands" },
        "F2": { "$ref": "#/$defs/commands" },
        "F3": { "$ref": "#/$defs/commands" },
        "F4": { "$ref": "#/$defs/commands" }
      }
    }
  },
  "$defs": {
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classification", "primary", "argv"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "classification": { "enum": ["repository", "external"] },
          "primary": { "type": "string", "minLength": 1 },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "environment": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    }
  }
}
