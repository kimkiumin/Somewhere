{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somewhere.invalid/schemas/planned-tree-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gate", "sourceTree", "destination", "inventoryDigest", "fileCount"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gate": { "const": "PASS" },
    "sourceTree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "destination": { "type": "string", "minLength": 1 },
    "inventoryDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "fileCount": { "type": "integer", "minimum": 1 }
  }
}
