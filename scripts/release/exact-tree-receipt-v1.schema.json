{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somewhere.example/schemas/exact-tree-command-receipt.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tree", "inventoryDigest", "argv", "cwd", "exitCode", "exitClass", "expectedClass", "assertion", "artifacts", "cleanup", "startedAt", "endedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "inventoryDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "cwd": { "type": "string", "minLength": 1 },
    "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
    "exitClass": { "enum": ["TDD_RED_NONZERO", "GREEN_ZERO", "NEGATIVE_PASS_ZERO", "MUTATION_CAUGHT_NONZERO"] },
    "expectedClass": { "enum": ["TDD_RED_NONZERO", "GREEN_ZERO", "NEGATIVE_PASS_ZERO", "MUTATION_CAUGHT_NONZERO"] },
    "assertion": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUnchanged", "temporaryRootRemovedByCaller"],
      "properties": {
        "sourceUnchanged": { "type": "boolean" },
        "temporaryRootRemovedByCaller": { "const": true }
      }
    }
  }
}
