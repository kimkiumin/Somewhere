{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somewhere.invalid/schemas/check-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gate", "lane", "checks", "registryDigest", "missing"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gate": { "enum": ["PASS", "BLOCK", "FAIL"] },
    "lane": { "enum": ["F1", "F2", "F3", "F4"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classification", "gate", "receipt", "receiptSha256", "primarySha256"],
        "properties": {
          "id": { "type": "string" },
          "classification": { "enum": ["repository", "external"] },
          "gate": { "enum": ["PASS", "BLOCK", "FAIL"] },
          "receipt": { "type": "string" },
          "receiptSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "primarySha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "registryDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "missing": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    }
  }
}
