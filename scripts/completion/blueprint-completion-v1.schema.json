{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somewhere.invalid/schemas/blueprint-completion-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "statusAsOf", "tracks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "statusAsOf": { "type": "string", "format": "date" },
    "tracks": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requiredForBlueprint",
          "requiredForPublicRelease",
          "gate",
          "evidence",
          "reason"
        ],
        "properties": {
          "id": {
            "enum": [
              "service-web-backend",
              "native-ios",
              "physical-product",
              "study-a",
              "study-b",
              "provider-legal",
              "public-operations"
            ]
          },
          "requiredForBlueprint": { "type": "boolean" },
          "requiredForPublicRelease": { "type": "boolean" },
          "gate": { "enum": ["PASS", "BLOCK", "FAIL"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
