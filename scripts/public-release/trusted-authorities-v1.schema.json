{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somewhere.invalid/schemas/trusted-authorities-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authorities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authorityId", "purposes", "publicKeyPem", "validFrom", "validUntil"],
        "properties": {
          "authorityId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
          "purposes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "external-receipt-v1.schema.json#/$defs/purpose" } },
          "publicKeyPem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" },
          "validFrom": { "type": "string", "format": "date-time" },
          "validUntil": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
