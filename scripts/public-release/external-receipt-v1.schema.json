{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somewhere.invalid/schemas/external-receipt-v1.json",
  "$defs": {
    "purpose": { "enum": ["cloudflare-production", "cloudflare-canonical-origin", "cloudflare-production-pitr", "provider-rights-quota", "korean-privacy-location-review", "study-a-rc", "physical-iphone", "native-distribution"] }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "payload", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "purpose", "authorityId", "issuedAt", "expiresAt", "finalSha", "sourceTree", "terminalManifestSha256", "decision", "evidenceDigests", "conditions"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "purpose": { "$ref": "#/$defs/purpose" },
        "authorityId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "finalSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourceTree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "terminalManifestSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "decision": { "enum": ["PASS", "BLOCK", "FAIL"] },
        "evidenceDigests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
        "conditions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signatureBase64", "signatureSha256"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "signatureBase64": { "type": "string", "contentEncoding": "base64" },
        "signatureSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
