{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somewhere.example/contracts/policy/navigation-v2-rc-1.schema.json",
  "title": "Somewhere V2 release-candidate navigation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "status",
    "routeCorridorEnterM",
    "routeCorridorExitM",
    "finalCorridorMaxDeviationM",
    "forwardTargetLookaheadM",
    "maxGuidanceAccuracyM",
    "maxMeasuredHeadingAccuracyDeg",
    "nearEnterM",
    "nearExitM",
    "arrivalEndpointM",
    "maxArrivalAccuracyM",
    "arrivalConsecutiveSamples",
    "arrivalMinimumDwellMs",
    "arrivalSampleWindowMs",
    "locationMaxAgeMs",
    "headingMaxAgeMs",
    "routeRevalidateAfterMs",
    "routeAbsoluteMaxAgeMs",
    "postVisibilityRequiresNewLocation",
    "postVisibilityRequiresNewHeading",
    "arrivedIsLatched",
    "parentPolicyVersion",
    "parentPolicySha256",
    "calibrationEvidenceSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyVersion": { "const": "navigation-v2-rc-1" },
    "status": { "const": "release-candidate" },
    "routeCorridorEnterM": { "type": "number", "minimum": 1, "maximum": 100 },
    "routeCorridorExitM": { "type": "number", "minimum": 1, "maximum": 150 },
    "finalCorridorMaxDeviationM": { "type": "number", "minimum": 1, "maximum": 75 },
    "forwardTargetLookaheadM": { "type": "number", "minimum": 5, "maximum": 100 },
    "maxGuidanceAccuracyM": { "type": "number", "minimum": 5, "maximum": 100 },
    "maxMeasuredHeadingAccuracyDeg": { "type": "number", "minimum": 1, "maximum": 90 },
    "nearEnterM": { "type": "number", "minimum": 20, "maximum": 250 },
    "nearExitM": { "type": "number", "minimum": 20, "maximum": 300 },
    "arrivalEndpointM": { "type": "number", "minimum": 5, "maximum": 75 },
    "maxArrivalAccuracyM": { "type": "number", "minimum": 5, "maximum": 75 },
    "arrivalConsecutiveSamples": { "type": "integer", "minimum": 2, "maximum": 10 },
    "arrivalMinimumDwellMs": { "type": "integer", "minimum": 5000, "maximum": 60000 },
    "arrivalSampleWindowMs": { "type": "integer", "minimum": 5000, "maximum": 120000 },
    "locationMaxAgeMs": { "type": "integer", "minimum": 1000, "maximum": 30000 },
    "headingMaxAgeMs": { "type": "integer", "minimum": 1000, "maximum": 30000 },
    "routeRevalidateAfterMs": { "type": "integer", "minimum": 60000, "maximum": 900000 },
    "routeAbsoluteMaxAgeMs": { "type": "integer", "minimum": 300000, "maximum": 3600000 },
    "postVisibilityRequiresNewLocation": { "const": true },
    "postVisibilityRequiresNewHeading": { "const": true },
    "arrivedIsLatched": { "const": true },
    "parentPolicyVersion": { "const": "navigation-v2-calibration-1" },
    "parentPolicySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "calibrationEvidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
